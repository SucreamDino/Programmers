   "source": [
    "nums = [3,1, 2, 3]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "13bb6394",
   "metadata": {},
   "outputs": [],
   "source": [
    "def solution(nums):\n",
    "    a = len(nums)/2\n",
    "    b = len(set(nums))\n",
    "\n",
    "    if a>b:\n",
    "        answer = b\n",
    "    else:\n",
    "        answer = a\n",
    "    \n",
    "    return answer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "662d842b",
   "metadata": {},
   "outputs": [],
   "source": [
    "#simpified version\n",
    "\n",
    "def solution(nums):\n",
    "    return min(len(nums)/2, len(set(nums)))"
   ]
  }
